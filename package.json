{
  "name": "vue-error-boundary-kit",
  "version": "0.3.3",
  "description": "Production-ready error boundaries for Vue 3 — declarative <ErrorBoundary> component, useErrorBoundary() composable, adapter-based error reporting (Sentry/Bugsnag/custom), SSR-safe.",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "license": "MIT",
  "homepage": "https://npm.vuecraft.ru/en/packages/vue-error-boundary-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/vue-error-boundary-kit.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/vue-error-boundary-kit/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "error-boundary",
    "error-handling",
    "ssr",
    "nuxt",
    "nuxt-module",
    "tanstack-query",
    "vue-query",
    "opentelemetry",
    "otel",
    "breadcrumbs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./global-capture": {
      "types": "./dist/useGlobalErrorCapture.d.ts",
      "import": "./dist/useGlobalErrorCapture.mjs",
      "require": "./dist/useGlobalErrorCapture.cjs"
    },
    "./async-boundary": {
      "types": "./dist/asyncBoundary.d.ts",
      "import": "./dist/asyncBoundary.mjs",
      "require": "./dist/asyncBoundary.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    },
    "./retry-backoff": {
      "types": "./dist/retryWithBackoff.d.ts",
      "import": "./dist/retryWithBackoff.mjs",
      "require": "./dist/retryWithBackoff.cjs"
    },
    "./adapters/console": {
      "types": "./dist/adapters/console.d.ts",
      "import": "./dist/adapters/console.mjs",
      "require": "./dist/adapters/console.cjs"
    },
    "./adapters/http": {
      "types": "./dist/adapters/http.d.ts",
      "import": "./dist/adapters/http.mjs",
      "require": "./dist/adapters/http.cjs"
    },
    "./adapters/sentry": {
      "types": "./dist/adapters/sentry.d.ts",
      "import": "./dist/adapters/sentry.mjs",
      "require": "./dist/adapters/sentry.cjs"
    },
    "./adapters/bugsnag": {
      "types": "./dist/adapters/bugsnag.d.ts",
      "import": "./dist/adapters/bugsnag.mjs",
      "require": "./dist/adapters/bugsnag.cjs"
    },
    "./adapters/logrocket": {
      "types": "./dist/adapters/logrocket.d.ts",
      "import": "./dist/adapters/logrocket.mjs",
      "require": "./dist/adapters/logrocket.cjs"
    },
    "./adapters/rate-limit": {
      "types": "./dist/adapters/rateLimit.d.ts",
      "import": "./dist/adapters/rateLimit.mjs",
      "require": "./dist/adapters/rateLimit.cjs"
    },
    "./adapters/otel": {
      "types": "./dist/adapters/otel.d.ts",
      "import": "./dist/adapters/otel.mjs",
      "require": "./dist/adapters/otel.cjs"
    },
    "./adapters/breadcrumbs": {
      "types": "./dist/adapters/breadcrumbs.d.ts",
      "import": "./dist/adapters/breadcrumbs.mjs",
      "require": "./dist/adapters/breadcrumbs.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.mjs",
      "require": "./dist/devtools.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.mjs",
      "require": "./dist/nuxt/module.cjs"
    },
    "./nuxt/runtime": {
      "types": "./dist/nuxt/runtime.d.ts",
      "import": "./dist/nuxt/runtime.mjs",
      "require": "./dist/nuxt/runtime.cjs"
    },
    "./tanstack-query": {
      "types": "./dist/integrations/tanstackQuery.d.ts",
      "import": "./dist/integrations/tanstackQuery.mjs",
      "require": "./dist/integrations/tanstackQuery.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.mjs",
      "require": "./dist/router.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "demo": "npm run dev --prefix demo",
    "demo:typecheck": "vue-tsc -p demo/tsconfig.json --noEmit",
    "demo:build": "npm run build --prefix demo",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "@tanstack/vue-query": "^5.0.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@tanstack/vue-query": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/kit": "^4.5.2",
    "@tanstack/vue-query": "^5.101.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/server-renderer": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.10"
  }
}
